# Keep Unix line endings for files that run inside Linux containers or bash, even when the
# repository is checked out on Windows (CRLF breaks shell scripts and Make).
* text=auto
*.sh text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.env text eol=lf
.env.example text eol=lf
*.py text eol=lf
*.sql text eol=lf
*.json text eol=lf
*.gguf binary
*.png binary
*.pdf binary
