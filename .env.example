# Copy to .env and fill in real values: cp .env.example .env
# Never commit .env. Every variable the code reads must be listed here with a safe placeholder.
# Keep comments on their own lines: some env-file parsers treat text after a value as part of it.

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (application data) -------------------------------------------
POSTGRES_USER=sportsbot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sportsbot
POSTGRES_PORT=5432
# Used when the backend runs on the host (make run).
# Inside the stack, docker-compose.yml points it at the postgres service.
DATABASE_URL=postgresql+psycopg://sportsbot:change-me-local-only@localhost:5432/sportsbot

# --- Qdrant (vector search) --------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- HDFS --------------------------------------------------------------------
# WebHDFS endpoint of the NameNode. Empty = the HDFS health check is skipped.
# With the bigdata profile on the host: http://localhost:9870
HDFS_WEBHDFS_URL=
# Same check for the backend container (make up). Empty when only the core profile runs.
STACK_HDFS_WEBHDFS_URL=

# --- Collector (Phase 3) ------------------------------------------------------
# local (files under data/bronze) or hdfs (WebHDFS). The collector container always uses hdfs.
BRONZE_BACKEND=local
BRONZE_ROOT=/sportsbot/bronze
# Sent in the User-Agent so site owners can reach us; use a team email.
COLLECTOR_CONTACT=
MIN_SECONDS_BETWEEN_REQUESTS_PER_HOST=3
HTTP_TIMEOUT_SECONDS=20
HTTP_RETRIES=2
MAX_ITEMS_PER_FETCH=200
SCHEDULER_TICK_SECONDS=30
# Response size cap per fetch, in bytes.
HTTP_MAX_BYTES=5000000
# WebHDFS user name for Bronze writes (HDFS permissions are off in development).
HDFS_USER=sportsbot
# Empty = default User-Agent "SportsBotG4/<version> (university Big Data project; news reader)";
# COLLECTOR_CONTACT is appended to it.
COLLECTOR_USER_AGENT=
# Empty = defaults relative to the repository (the collector image sets its own).
SOURCES_FILE=
MIGRATIONS_DIR=
LOCAL_BRONZE_DIR=

# --- Health checks -----------------------------------------------------------
HEALTH_TIMEOUT_SECONDS=2.0

# --- Streaming pipeline (ADR 0005) -------------------------------------------
# Kafka from the host; inside the stack docker-compose.yml uses kafka:9092.
KAFKA_BOOTSTRAP_SERVERS=localhost:9094
# Articles with less extracted text than this go to the dead-letter topic.
EXTRACT_MIN_CHARS=300
# Extracted articles per Bronze archive file.
ARCHIVE_BATCH_SIZE=100
CHUNK_MAX_CHARS=1200
CHUNK_OVERLAP_CHARS=200
# Bronze target of the streaming workers: local (volume) or hdfs (needs the bigdata profile).
STREAM_BRONZE_BACKEND=local

# --- AI services: BGE-M3 embeddings + bge-reranker-v2-m3 (llama.cpp, GGUF) ----
# From the host (make ask). Inside the stack: http://embedder:8080 and http://reranker:8080.
EMBEDDING_BASE_URL=http://localhost:8091
EMBEDDING_MODEL=bge-m3
RERANK_BASE_URL=http://localhost:8092
RERANK_MODEL=bge-reranker-v2-m3
# Candidates below this reranker score are dropped (tune on the golden question set).
RERANK_MIN_SCORE=-2.0
# Candidates per retrieval stage (keyword, vector) before fusion.
RETRIEVAL_CANDIDATES=30
# Fused candidates sent to the reranker (fewer = faster on CPU).
RERANK_TOP=12
RETRIEVAL_TOP_K=5
# Used by the BM25 terminal prototype (make chat) only.
RETRIEVAL_MIN_MATCHED_TERMS=1
# Optional: model files and the llama.cpp image used by the ai profile.
EMBEDDING_GGUF=
# CPU threads for the llama.cpp servers (default 6 each).
EMBEDDER_THREADS=
RERANKER_THREADS=
RERANK_GGUF=
LLAMA_CPP_IMAGE=
# Optional: point the stack at native servers on the host (faster on a Mac), e.g.
# http://host.docker.internal:8091 and http://host.docker.internal:8092
STACK_EMBEDDING_BASE_URL=
STACK_RERANK_BASE_URL=

# --- Monitoring and alerts (make monitor-once; service `monitor`) -------------
# Check interval in seconds (default 15 minutes).
MONITOR_INTERVAL_SECONDS=900
# Fill one or both. Discord: channel settings > Integrations > Webhooks > New > Copy URL.
ALERT_DISCORD_WEBHOOK_URL=
# Telegram: create a bot with @BotFather (token), then the chat id of your group.
ALERT_TELEGRAM_BOT_TOKEN=
ALERT_TELEGRAM_CHAT_ID=

# --- Kaggle (private team dataset; make kaggle-push / make kaggle-pull) -------
# <kaggle-username-of-the-owner>/<slug>, e.g. khoaminh/sportsbot-corpus. Same value for everyone.
KAGGLE_DATASET=
# Kaggle → Settings → API → Create New Token. Personal: never share or commit it.
KAGGLE_API_TOKEN=

# --- Chat LLM: free Gemini models, tried in turn (ADR 0006) -----------------
# Create a free key at https://aistudio.google.com/apikey. Never commit it.
GEMINI_API_KEY=
GEMINI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
# Tried in this order; a model that hits its quota rests, the next one answers.
# Check which ones work with your key: make llm-check
GEMINI_MODELS=gemini-3.8-flash,gemini-3.6-flash,gemini-3.5-flash-lite,gemini-3.1-flash-lite
# Thinking budget of Gemini 3.x models: low (fast, default), medium, high; empty = model default.
LLM_REASONING_EFFORT=low
# Seconds a model rests after a per-minute quota error (daily quota: until midnight Pacific).
LLM_COOLDOWN_SECONDS=65
# Per model: a slow model is abandoned and the next one is tried.
LLM_TIMEOUT_SECONDS=30
# Thinking tokens count too: keep room so answers are not cut off.
LLM_MAX_TOKENS=1500
LLM_TEMPERATURE=0.1

# --- Backend chat and live news ------------------------------------------------
CHAT_ENABLED=true
# How often /ws/news looks for new articles, in seconds.
NEWS_POLL_SECONDS=5

# --- BM25 terminal prototype (make chat) ---------------------------------------
# Folder with stored articles (Bronze JSON Lines); filled by `make articles-export`.
ARTICLES_DIR=

# --- Tests only (read by pytest, not by the application) ---------------------
# Uncomment to run the integration tests against a running stack (make test-integration).
# SPORTSBOT_INTEGRATION=1
# Set when the bigdata profile also runs, so the backend's HDFS check is asserted.
# EXPECT_HDFS=1
# Where the integration tests reach the services from the host.
# BACKEND_URL=http://localhost:8000
# QDRANT_URL_HOST=http://localhost:6333
