# Copy to .env and fill in real values: cp .env.example .env
# Never commit .env. Every variable the code reads must be listed here with a safe placeholder.
# Keep comments on their own lines: some env-file parsers treat text after a value as part of it.

# --- Application -------------------------------------------------------------
# development | test | production
APP_ENV=development
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
# json | text
LOG_FORMAT=json
# Comma-separated origins allowed to call the API from a browser
CORS_ORIGINS=http://localhost:5173

# --- PostgreSQL (application data) -------------------------------------------
POSTGRES_USER=sportsbot
POSTGRES_PASSWORD=change-me-local-only
POSTGRES_DB=sportsbot
POSTGRES_PORT=5432
# Used when the backend runs on the host (make run).
# Inside the stack, docker-compose.yml points it at the postgres service.
DATABASE_URL=postgresql+psycopg://sportsbot:change-me-local-only@localhost:5432/sportsbot

# --- Qdrant (vector search) --------------------------------------------------
QDRANT_URL=http://localhost:6333

# --- HDFS --------------------------------------------------------------------
# WebHDFS endpoint of the NameNode. Empty = the HDFS health check is skipped.
# With the bigdata profile on the host: http://localhost:9870
HDFS_WEBHDFS_URL=
# Same check for the backend container (make up). Empty when only the core profile runs.
STACK_HDFS_WEBHDFS_URL=

# --- Health checks -----------------------------------------------------------
HEALTH_TIMEOUT_SECONDS=2.0

# --- LLM (Phase 4; OpenAI-compatible endpoint; never hard-code a vendor) -----
LLM_BASE_URL=
LLM_API_KEY=
LLM_MODEL=

# --- Embeddings (Phase 4) ----------------------------------------------------
EMBEDDING_MODEL=intfloat/multilingual-e5-small
