# HDFS configuration for the official apache/hadoop image.
# The image turns FILE.XML_property=value variables into entries of that Hadoop XML file.
# Development settings (see ADR 0002): permissions off, replication 2 over 2 DataNodes.

CORE-SITE.XML_fs.defaultFS=hdfs://namenode:8020
CORE-SITE.XML_fs.default.name=hdfs://namenode:8020

HDFS-SITE.XML_dfs.namenode.rpc-address=namenode:8020
HDFS-SITE.XML_dfs.namenode.http-address=0.0.0.0:9870
HDFS-SITE.XML_dfs.namenode.name.dir=/hadoop/dfs/name
HDFS-SITE.XML_dfs.datanode.data.dir=/hadoop/dfs/data
HDFS-SITE.XML_dfs.replication=2
HDFS-SITE.XML_dfs.permissions.enabled=false
HDFS-SITE.XML_dfs.webhdfs.enabled=true
# DataNodes register by container hostname so WebHDFS redirects work inside the Compose network.
HDFS-SITE.XML_dfs.client.use.datanode.hostname=true
HDFS-SITE.XML_dfs.datanode.use.datanode.hostname=true
HDFS-SITE.XML_dfs.namenode.datanode.registration.ip-hostname-check=false
